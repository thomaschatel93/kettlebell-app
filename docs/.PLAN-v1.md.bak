### Task 6: Pool filtering

**Files:**
- Create: `src/lib/pool.ts`
- Test: `tests/pool.test.ts`

**Interfaces:**
- Consumes: `resolveBell`, `hasMatchedPair` from Task 5; `levelRank` from Task 2
- Produces: `filterPool(exercises, req, kit): Exercise[]`, `filterCombos(combos, exercises, req, kit): Combo[]`, `warmupPool(exercises, kit)`, `cooldownPool(exercises, kit)`

- [ ] **Step 1: Write the failing test**

`tests/pool.test.ts`:

```ts
import { describe, it, expect } from 'vitest';
import { filterPool } from '@/lib/pool';
import type { Exercise, KitProfile, WorkoutRequest } from '@/lib/types';

const ex = (over: Partial<Exercise>): Exercise => ({
  id: 'x', name: 'X', patterns: ['hinge'], level: 'beginner', mechanic: 'grind',
  unilateral: false, bells: 1, loadBand: 'moderate', secondsPerRep: 4, defaultReps: 8,
  needsBench: false, warmupSuitable: false, cooldownSuitable: false, image: null,
  imagePanels: 1, cues: { setup: ['a'], execution: ['b'], mistakes: ['c'] }, ...over,
});

const req = (over: Partial<WorkoutRequest> = {}): WorkoutRequest => ({
  kitProfileId: 'k', patterns: ['hinge'], level: 'intermediate',
  totalMinutes: 30, format: 'auto', seed: 1, ...over,
});

const kit = (over: Partial<KitProfile> = {}): KitProfile => ({
  id: 'k', name: 'K', bells: [{ weightKg: 16, count: 1 }], hasBench: false, ...over,
});

describe('filterPool', () => {
  it('drops exercises above the requested level', () => {
    const pool = filterPool([ex({ id: 'adv', level: 'advanced' })], req(), kit());
    expect(pool).toEqual([]);
  });

  it('drops two-bell exercises without a matched pair', () => {
    const doubles = ex({ id: 'd', bells: 2 });
    expect(filterPool([doubles], req(), kit())).toEqual([]);
    expect(filterPool([doubles], req(), kit({ bells: [{ weightKg: 16, count: 2 }] }))).toHaveLength(1);
  });

  it('drops bench exercises without a bench', () => {
    const bench = ex({ id: 'b', needsBench: true });
    expect(filterPool([bench], req(), kit())).toEqual([]);
    expect(filterPool([bench], req(), kit({ hasBench: true }))).toHaveLength(1);
  });

  it('drops exercises that train none of the requested patterns', () => {
    expect(filterPool([ex({ patterns: ['core'] })], req({ patterns: ['hinge'] }), kit())).toEqual([]);
  });

  it('drops bell exercises when the kit is empty', () => {
    expect(filterPool([ex({})], req(), kit({ bells: [] }))).toEqual([]);
  });

  it('excludes warm-up-only moves from the main pool', () => {
    expect(filterPool([ex({ warmupSuitable: true })], req(), kit())).toEqual([]);
  });

  it('keeps an exercise that satisfies everything', () => {
    expect(filterPool([ex({})], req(), kit())).toHaveLength(1);
  });
});
