const entry = (over: Partial<HistoryEntry> = {}): HistoryEntry => ({
  id: 'h1', createdAt: new Date().toISOString(), format: 'circuit',
  request: { kitProfileId: 'home', patterns: ['hinge'], level: 'beginner', totalMinutes: 30, format: 'auto', seed: 1 },
  exerciseIds: ['two-hand-swing'], workedSeconds: 1500, ...over,
});

beforeEach(() => localStorage.clear());

describe('HomeScreen', () => {
  it('invites a first workout when there is no history', () => {
    render(<HomeScreen />);
    expect(screen.getByText(/no workouts yet/i)).toBeDefined();
  });

  it('counts this week and the total minutes', () => {
    pushHistory(entry({ id: 'a' }));
    pushHistory(entry({ id: 'b' }));
    render(<HomeScreen />);
    expect(screen.getByRole('img', { name: /Workouts this week: 2/ })).toBeDefined();
    expect(screen.getByRole('img', { name: /Minutes: 50/ })).toBeDefined();
  });

  it('ignores workouts older than seven days in the weekly count', () => {
    const old = new Date(Date.now() - 10 * 864e5).toISOString();
    pushHistory(entry({ id: 'old', createdAt: old }));
    render(<HomeScreen />);
    expect(screen.getByRole('img', { name: /Workouts this week: 0/ })).toBeDefined();
  });

  it('names the active kit', () => {
    saveKits({ profiles: [{ id: 'gym', name: 'Gym', bells: [], hasBench: true }], activeId: 'gym' });
    render(<HomeScreen />);
    expect(screen.getByText('Gym')).toBeDefined();
  });
});
```

- [ ] **Step 2: Run it and watch it fail**

Run: `npm test -- home`
Expected: FAIL, component not found.

- [ ] **Step 3: Implement**

`src/components/HomeScreen.tsx` hydrates history and kits in `useEffect` and renders:

- a greeting heading
- three `<Ring>` components: workouts in the last seven days, total minutes across
  the stored history, and the current run of consecutive days with a workout
- the active kit name as a chip linking to `/kit`
- a full-width "Start a workout" button linking to `/workout`
- a "Resume workout" button above it when `loadActive()` is not null
- a card summarising the most recent workout, or "No workouts yet" when there is none

`src/app/workout/done/page.tsx` reads the newest history entry and shows the worked
time, the number of exercises and the patterns trained, with a button home.

`src/app/history/page.tsx` lists history newest first, each row showing the date,
the format, the duration and the pattern tags, expanding on tap to name the
exercises.

`src/components/TabBar.tsx` is a fixed bottom bar with Home, Workout, History and
Kit, using `usePathname` to mark the current tab with `aria-current="page"`. It is
rendered from `layout.tsx` and hidden on `/workout/run`, so nothing sits under the
thumb mid-set.

- [ ] **Step 4: Run tests**

Run: `npm test`
Expected: PASS, every file.

