Append to `src/lib/types.ts`:

```ts
export const LEVELS = ['beginner', 'intermediate', 'advanced'] as const;
export type Level = (typeof LEVELS)[number];
export const levelRank = (l: Level): number => LEVELS.indexOf(l);

export type Mechanic = 'ballistic' | 'grind' | 'carry';
export type LoadBand = 'light' | 'moderate' | 'heavy';
export type Block = 'Warm-up' | 'Main' | 'Cool-down';
export type Format = 'circuit' | 'complex' | 'strength';

export interface Exercise {
  id: string;
  name: string;
  patterns: Pattern[];          // primary first
  level: Level;
  mechanic: Mechanic;
  unilateral: boolean;
  bells: 0 | 1 | 2;             // 0 for bodyweight warm-up and cool-down moves
  loadBand: LoadBand;
  secondsPerRep: number;
  defaultReps?: number;
  defaultWorkSeconds?: number;
  needsBench: boolean;
  warmupSuitable: boolean;
  cooldownSuitable: boolean;
  image: string | null;
  imagePanels: 1 | 2;
  cues: { setup: string[]; execution: string[]; mistakes: string[] };
}

export interface Combo {
  id: string;
  name: string;
  level: Level;
  bells: 1 | 2;
  perSide: boolean;
  loadBand: LoadBand;
  steps: { exerciseId: string; reps: number }[];
}

export interface KitProfile {
  id: string;
  name: string;
  bells: { weightKg: number; count: number }[];
  hasBench: boolean;
}

export interface WorkoutRequest {
  kitProfileId: string;
  patterns: Pattern[];
  level: Level;
  totalMinutes: 15 | 20 | 30 | 45 | 60;
  format: 'auto' | Format;
  seed: number;
}

export type Step =
  | {
      kind: 'work';
      exerciseId: string;
      name: string;
      bellKg: number | null;
      reps?: number;
      seconds?: number;
      perSide: boolean;
      block: Block;
      round: number;
      totalRounds: number;
      indexInRound: number;
      itemsInRound: number;
      estSeconds: number;
    }
  | {
      kind: 'rest';
      seconds: number;
      nextName: string;
      block: Block;
      estSeconds: number;
    };

export interface Workout {
  id: string;
  createdAt: string;
  request: WorkoutRequest;
  format: Format;
  steps: Step[];
  estimatedSeconds: number;
}

export interface HistoryEntry {
  id: string;
  createdAt: string;
  request: WorkoutRequest;
  format: Format;
  exerciseIds: string[];
  workedSeconds: number;
}
```

