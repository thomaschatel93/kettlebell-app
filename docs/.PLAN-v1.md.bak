- [ ] **Step 3: Implement**

`src/lib/fit.ts`:

```ts
export const roundDuration = (works: number[], restSeconds: number): number =>
  works.reduce((a, b) => a + b, 0) + Math.max(0, works.length - 1) * restSeconds;

export const deviation = (actual: number, target: number): number =>
  target === 0 ? Infinity : Math.abs(actual - target) / target;

export function chooseRounds(roundSeconds: number, betweenRest: number, budgetSeconds: number): number {
  let best = 1;
  let bestDev = Infinity;
  for (let r = 1; r <= 8; r++) {
    const total = r * roundSeconds + (r - 1) * betweenRest;
    const dev = Math.abs(total - budgetSeconds);
    if (dev < bestDev) { bestDev = dev; best = r; }
  }
  return best;
}
```

`src/lib/flatten.ts`:

```ts
import type { Block, Exercise, Step } from '@/lib/types';

export interface PlannedItem {
  exercise: Exercise;
  bellKg: number | null;
  reps?: number;
  seconds?: number;
  restSeconds: number;
  estSeconds: number;
}

export interface BlockPlan {
  block: Block;
  rounds: number;
  betweenRoundsRest: number;
  items: PlannedItem[];
}

export function buildSteps(plans: BlockPlan[]): Step[] {
  const steps: Step[] = [];

  for (const plan of plans) {
    for (let round = 1; round <= plan.rounds; round++) {
      plan.items.forEach((item, i) => {
        steps.push({
          kind: 'work',
          exerciseId: item.exercise.id,
          name: item.exercise.name,
          bellKg: item.bellKg,
          reps: item.reps,
          seconds: item.seconds,
          perSide: item.exercise.unilateral,
          block: plan.block,
          round,
          totalRounds: plan.rounds,
          indexInRound: i + 1,
          itemsInRound: plan.items.length,
          estSeconds: item.estSeconds,
        });

        const lastOfRound = i === plan.items.length - 1;
        const rest = lastOfRound ? plan.betweenRoundsRest : item.restSeconds;
        if (rest > 0) {
          steps.push({ kind: 'rest', seconds: rest, nextName: '', block: plan.block, estSeconds: rest });
        }
      });
    }
  }

  // Trim a trailing rest, then name what follows each remaining one.
  while (steps.length && steps[steps.length - 1].kind === 'rest') steps.pop();
  for (let i = 0; i < steps.length; i++) {
    const s = steps[i];
    if (s.kind !== 'rest') continue;
    const next = steps.slice(i + 1).find((n) => n.kind === 'work');
    s.nextName = next && next.kind === 'work' ? next.name : '';
  }

  return steps;
}
```

