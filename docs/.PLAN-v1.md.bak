- [ ] **Step 3: Implement**

`src/lib/prescribe.ts`:

```ts
import type { Exercise, Format, Level } from '@/lib/types';

export interface Prescription { reps?: number; seconds?: number; restSeconds: number }

const REP_FACTOR: Record<Level, number> = { beginner: 0.7, intermediate: 1, advanced: 1.2 };
const REST_FACTOR: Record<Level, number> = { beginner: 1.5, intermediate: 1, advanced: 0.8 };
const BASE_ITEM_REST: Record<Format, number> = { circuit: 30, complex: 0, strength: 90 };
const BASE_ROUND_REST: Record<Format, number> = { circuit: 75, complex: 90, strength: 0 };

const toFive = (n: number) => Math.round(n / 5) * 5;

export function prescribe(exercise: Exercise, format: Format, level: Level): Prescription {
  const restSeconds = toFive(BASE_ITEM_REST[format] * REST_FACTOR[level]);

  if (exercise.defaultReps === undefined && exercise.defaultWorkSeconds !== undefined) {
    return { seconds: Math.max(15, toFive(exercise.defaultWorkSeconds * REP_FACTOR[level])), restSeconds };
  }

  const base = format === 'strength' ? 5 : (exercise.defaultReps ?? 8);
  return { reps: Math.max(3, Math.round(base * REP_FACTOR[level])), restSeconds };
}

export function estimateWork(exercise: Exercise, p: Prescription): number {
  const base = p.seconds ?? (p.reps ?? 0) * exercise.secondsPerRep;
  return exercise.unilateral ? base * 2 : base;
}

export const betweenRoundsRest = (format: Format, level: Level): number =>
  toFive(BASE_ROUND_REST[format] * REST_FACTOR[level]);
```

