- [ ] **Step 3: Implement**

`src/lib/generate.ts`:

```ts
import type {
  Combo, Exercise, Format, HistoryEntry, KitProfile, Workout, WorkoutRequest,
} from '@/lib/types';
import { createRng, shuffle } from '@/lib/rng';
import { resolveBell } from '@/lib/kit';
import { cooldownPool, filterCombos, filterPool, warmupPool } from '@/lib/pool';
import { budget } from '@/lib/budget';
import { chooseFormat } from '@/lib/format';
import { selectCircuit, selectComplex, selectStrength } from '@/lib/select';
import { betweenRoundsRest, estimateWork, prescribe } from '@/lib/prescribe';
import { chooseRounds, deviation, roundDuration } from '@/lib/fit';
import { buildSteps, type BlockPlan, type PlannedItem } from '@/lib/flatten';

export interface GenerateInput {
  request: WorkoutRequest;
  kit: KitProfile;
  exercises: Exercise[];
  combos: Combo[];
  history: HistoryEntry[];
  now: string;
}

const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

const bellFor = (e: Exercise, kit: KitProfile, band = e.loadBand) =>
  e.bells === 0 ? null : resolveBell(band, kit);

const plannedItem = (
  e: Exercise, kit: KitProfile, format: Format, level: WorkoutRequest['level'],
): PlannedItem => {
  const p = prescribe(e, format, level);
  return {
    exercise: e, bellKg: bellFor(e, kit), reps: p.reps, seconds: p.seconds,
    restSeconds: p.restSeconds, estSeconds: estimateWork(e, p),
  };
};

function buildCircuit(
  pool: Exercise[], req: WorkoutRequest, kit: KitProfile, history: HistoryEntry[],
  mainSeconds: number, seed: number,
): BlockPlan {
  const preferred = clamp(req.patterns.length + 1, 4, 6);
  const counts = [...new Set([preferred, 4, 5, 6])].filter((c) => c <= Math.max(1, pool.length));
  const between = betweenRoundsRest('circuit', req.level);

  let best: BlockPlan | null = null;
  let bestDev = Infinity;

  for (const count of counts.length ? counts : [Math.max(1, pool.length)]) {
    const items = selectCircuit(pool, req, createRng(seed + count), history, count)
      .map((e) => plannedItem(e, kit, 'circuit', req.level));
    if (items.length === 0) continue;

    const secs = roundDuration(items.map((i) => i.estSeconds), items[0].restSeconds);
    const rounds = chooseRounds(secs, between, mainSeconds);
    const dev = deviation(rounds * secs + (rounds - 1) * between, mainSeconds);
    if (dev < bestDev) { bestDev = dev; best = { block: 'Main', rounds, betweenRoundsRest: between, items }; }
  }

  return best ?? { block: 'Main', rounds: 1, betweenRoundsRest: between, items: [] };
}

function buildComplex(
  combos: Combo[], exercises: Exercise[], req: WorkoutRequest, kit: KitProfile,
  history: HistoryEntry[], mainSeconds: number, seed: number,
): BlockPlan | null {
  const combo = selectComplex(combos, createRng(seed), history);
  if (!combo) return null;

  const items: PlannedItem[] = combo.steps.flatMap((s) => {
    const e = exercises.find((x) => x.id === s.exerciseId);
    if (!e) return [];
    const reps = Math.max(2, Math.round(s.reps * (req.level === 'beginner' ? 0.7 : req.level === 'advanced' ? 1.2 : 1)));
    const estSeconds = (combo.perSide ? 2 : 1) * reps * e.secondsPerRep;
    return [{ exercise: e, bellKg: bellFor(e, kit, combo.loadBand), reps, restSeconds: 0, estSeconds }];
  });
  if (items.length === 0) return null;

  const between = betweenRoundsRest('complex', req.level);
  const secs = roundDuration(items.map((i) => i.estSeconds), 0);
  return { block: 'Main', rounds: chooseRounds(secs, between, mainSeconds), betweenRoundsRest: between, items };
}

function buildStrength(
  pool: Exercise[], req: WorkoutRequest, kit: KitProfile, history: HistoryEntry[],
  mainSeconds: number, seed: number,
): BlockPlan {
  const items = selectStrength(pool, req, createRng(seed), history)
    .map((e) => plannedItem(e, kit, 'strength', req.level));
  const between = betweenRoundsRest('strength', req.level); // zero: sets rest between exercises
  if (items.length === 0) return { block: 'Main', rounds: 1, betweenRoundsRest: 0, items };
  const secs = roundDuration(items.map((i) => i.estSeconds), items[0].restSeconds);
  return {
    block: 'Main',
    rounds: clamp(chooseRounds(secs, between, mainSeconds), 3, 5),
    betweenRoundsRest: between,
    items,
  };
}

function buildAncillary(
  pool: Exercise[], kit: KitProfile, block: 'Warm-up' | 'Cool-down',
  budgetSeconds: number, restSeconds: number, seed: number,
): BlockPlan {
  const shuffled = shuffle(createRng(seed), pool);
  const items: PlannedItem[] = [];
  let used = 0;

  for (const e of shuffled) {
    if (items.length >= 6) break;
    const seconds = e.defaultWorkSeconds ?? 30;
    const cost = seconds * (e.unilateral ? 2 : 1) + restSeconds;
    // Stop at whichever count sits closest to the budget, rather than always
    // undershooting by a whole item. A 15 minute session cannot afford to lose
    // 45 seconds off each ancillary block and still hold the ten per cent rule.
    if (items.length > 0 && Math.abs(used + cost - budgetSeconds) >= Math.abs(used - budgetSeconds)) break;
    items.push({
      exercise: e, bellKg: bellFor(e, kit, 'light'), seconds,
      restSeconds, estSeconds: seconds * (e.unilateral ? 2 : 1),
    });
    used += cost;
  }

  return { block, rounds: 1, betweenRoundsRest: 0, items };
}

const mainIds = (plan: BlockPlan) => [...new Set(plan.items.map((i) => i.exercise.id))].sort();

export function generate(input: GenerateInput): Workout {
  const { request, kit, exercises, combos, history, now } = input;
  const b = budget(request.totalMinutes);
  const pool = filterPool(exercises, request, kit);
  const usableCombos = filterCombos(combos, exercises, request, kit);
  const format: Format = chooseFormat(request, usableCombos.length > 0);

  const buildMain = (seed: number): BlockPlan => {
    if (format === 'complex') {
      return buildComplex(usableCombos, exercises, request, kit, history, b.mainSeconds, seed)
        ?? buildCircuit(pool, request, kit, history, b.mainSeconds, seed);
    }
    if (format === 'strength') return buildStrength(pool, request, kit, history, b.mainSeconds, seed);
    return buildCircuit(pool, request, kit, history, b.mainSeconds, seed);
  };

  let seed = request.seed;
  let main = buildMain(seed);
  const previous = history[0] ? [...new Set(history[0].exerciseIds)].sort() : null;
  for (let attempt = 0; attempt < 5 && previous && mainIds(main).join() === previous.join(); attempt++) {
    seed += 1;
    main = buildMain(seed);
  }

  const warm = buildAncillary(warmupPool(exercises, kit), kit, 'Warm-up', b.warmupSeconds, 15, seed + 101);
  const cool = buildAncillary(cooldownPool(exercises, kit), kit, 'Cool-down', b.cooldownSeconds, 10, seed + 202);

  const steps = buildSteps([warm, main, cool].filter((p) => p.items.length > 0));

  return {
    id: `w-${request.seed}-${now}`,
    createdAt: now,
    request: { ...request, seed },
    format,
    steps,
    estimatedSeconds: steps.reduce((a, s) => a + s.estSeconds, 0),
  };
}
```

