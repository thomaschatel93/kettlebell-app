import { describe, it, expect } from 'vitest';
import { generate } from '@/lib/generate';
import { EXERCISES } from '@/lib/data/exercises';
import { COMBOS } from '@/lib/data/combos';
import { levelRank } from '@/lib/types';
import type { HistoryEntry, KitProfile, Pattern, WorkoutRequest } from '@/lib/types';

const KIT: KitProfile = {
  id: 'gym', name: 'Gym', hasBench: true,
  bells: [{ weightKg: 16, count: 2 }, { weightKg: 24, count: 1 }, { weightKg: 32, count: 1 }],
};

const HOME: KitProfile = { id: 'home', name: 'Home', hasBench: false, bells: [{ weightKg: 16, count: 1 }] };

const NOW = '2026-08-25T09:00:00.000Z';
const ALL: Pattern[] = ['hinge', 'squat', 'push', 'pull', 'carry', 'core'];

const req = (over: Partial<WorkoutRequest> = {}): WorkoutRequest => ({
  kitProfileId: 'gym', patterns: ['hinge', 'squat', 'push'], level: 'intermediate',
  totalMinutes: 30, format: 'auto', seed: 1, ...over,
});

const run = (over: Partial<WorkoutRequest> = {}, kit = KIT, history: HistoryEntry[] = []) =>
  generate({ request: req(over), kit, exercises: EXERCISES, combos: COMBOS, history, now: NOW });

/** Every combination worth sweeping, so the invariants are checked broadly. */
const sweep = function* () {
  for (const totalMinutes of [15, 20, 30, 45, 60] as const)
    for (const level of ['beginner', 'intermediate', 'advanced'] as const)
      for (const format of ['auto', 'circuit', 'complex', 'strength'] as const)
        for (const seed of [1, 2, 3, 4, 5])
          for (const patterns of [['hinge'], ['push', 'pull'], ['hinge', 'squat', 'push'], ALL])
            yield { totalMinutes, level, format, seed, patterns } as Partial<WorkoutRequest>;
};

describe('generate: hard invariants', () => {
  it('never prescribes a bell absent from the kit', () => {
    const owned = new Set([16, 24, 32]);
    for (const o of sweep()) {
      for (const s of run(o).steps) {
        if (s.kind === 'work' && s.bellKg !== null) expect(owned).toContain(s.bellKg);
      }
    }
  });

  it('never selects a two-bell exercise without a matched pair', () => {
    for (const o of sweep()) {
      for (const s of run(o, HOME).steps) {
        if (s.kind !== 'work') continue;
        const ex = EXERCISES.find((e) => e.id === s.exerciseId)!;
        expect(ex.bells).toBeLessThan(2);
      }
    }
  });

  it('never selects a bench exercise without a bench', () => {
    for (const o of sweep()) {
      for (const s of run(o, HOME).steps) {
        if (s.kind !== 'work') continue;
        expect(EXERCISES.find((e) => e.id === s.exerciseId)!.needsBench).toBe(false);
      }
    }
  });

  it('never exceeds the requested level', () => {
    for (const o of sweep()) {
      const w = run(o);
      for (const s of w.steps) {
        if (s.kind !== 'work') continue;
        const ex = EXERCISES.find((e) => e.id === s.exerciseId)!;
        expect(levelRank(ex.level)).toBeLessThanOrEqual(levelRank(w.request.level));
      }
    }
  });

  it('lands within ten per cent of the requested time', () => {
    for (const o of sweep()) {
      const w = run(o);
      const target = w.request.totalMinutes * 60;
      expect(Math.abs(w.estimatedSeconds - target) / target).toBeLessThanOrEqual(0.1);
    }
  });

  it('always runs warm-up, then main, then cool-down', () => {
    for (const o of sweep()) {
      const order = run(o).steps.map((s) => s.block);
      expect(order[0]).toBe('Warm-up');
      expect(order[order.length - 1]).toBe('Cool-down');
      const rank = { 'Warm-up': 0, Main: 1, 'Cool-down': 2 } as const;
      for (let i = 1; i < order.length; i++) expect(rank[order[i]]).toBeGreaterThanOrEqual(rank[order[i - 1]]);
    }
  });

  it('never ends on a rest', () => {
    for (const o of sweep()) {
      const steps = run(o).steps;
      expect(steps[steps.length - 1].kind).toBe('work');
    }
  });

  it('produces at least one main work step every time', () => {
    for (const o of sweep()) {
      expect(run(o).steps.some((s) => s.kind === 'work' && s.block === 'Main')).toBe(true);
    }
  });
});

describe('generate: circuit invariants', () => {
  it('covers every requested pattern', () => {
    for (const patterns of [['hinge'], ['push', 'pull'], ['hinge', 'squat', 'push'], ALL]) {
      for (const seed of [1, 2, 3, 4, 5]) {
        const w = run({ patterns: patterns as Pattern[], format: 'circuit', seed });
        const covered = new Set(
          w.steps.filter((s) => s.kind === 'work' && s.block === 'Main')
            .flatMap((s) => EXERCISES.find((e) => e.id === (s as { exerciseId: string }).exerciseId)!.patterns),
        );
        for (const p of patterns) expect(covered).toContain(p);
      }
    }
  });

  it('never places two exercises sharing a primary pattern back to back', () => {
    for (const seed of [1, 2, 3, 4, 5]) {
      const main = run({ format: 'circuit', patterns: ALL, seed }).steps
        .filter((s) => s.kind === 'work' && s.block === 'Main')
        .map((s) => EXERCISES.find((e) => e.id === (s as { exerciseId: string }).exerciseId)!.patterns[0]);
      const firstRound = main.slice(0, new Set(main).size);
      for (let i = 1; i < firstRound.length; i++) expect(firstRound[i]).not.toBe(firstRound[i - 1]);
    }
  });
});

describe('generate: determinism and variety', () => {
  it('produces the same workout for the same seed', () => {
    expect(run({ seed: 7 })).toEqual(run({ seed: 7 }));
  });

  it('produces a different workout for a different seed', () => {
    const a = run({ seed: 7 }).steps.map((s) => (s.kind === 'work' ? s.exerciseId : 'rest'));
    const b = run({ seed: 8 }).steps.map((s) => (s.kind === 'work' ? s.exerciseId : 'rest'));
    expect(a).not.toEqual(b);
  });

  it('avoids repeating the previous workout exactly', () => {
    const first = run({ seed: 12, format: 'circuit' });
    const ids = [...new Set(first.steps.filter((s) => s.kind === 'work' && s.block === 'Main')
      .map((s) => (s as { exerciseId: string }).exerciseId))];
    const history: HistoryEntry[] = [{
      id: 'h1', createdAt: NOW, request: first.request, format: 'circuit',
      exerciseIds: ids, workedSeconds: 1500,
    }];
    const second = run({ seed: 12, format: 'circuit' }, KIT, history);
    const nextIds = [...new Set(second.steps.filter((s) => s.kind === 'work' && s.block === 'Main')
      .map((s) => (s as { exerciseId: string }).exerciseId))];
    expect(nextIds.sort()).not.toEqual(ids.sort());
  });
});

describe('generate: degraded inputs', () => {
  it('still returns a workout with a single bell and no bench', () => {
    const w = run({ patterns: ALL }, HOME);
    expect(w.steps.some((s) => s.kind === 'work' && s.block === 'Main')).toBe(true);
  });

  it('still returns a workout when nothing has an image yet', () => {
    const noImages = EXERCISES.map((e) => ({ ...e, image: null }));
    const w = generate({ request: req(), kit: KIT, exercises: noImages, combos: COMBOS, history: [], now: NOW });
    expect(w.steps.length).toBeGreaterThan(0);
  });

  it('returns an empty-kit workout of bodyweight warm-up and cool-down only', () => {
    const empty: KitProfile = { id: 'x', name: 'None', bells: [], hasBench: false };
    const w = run({}, empty);
    for (const s of w.steps) if (s.kind === 'work') expect(s.bellKg).toBeNull();
  });
});
