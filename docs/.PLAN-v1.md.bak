- [ ] **Step 3: Implement**

`src/lib/select.ts`:

```ts
import type { Combo, Exercise, HistoryEntry, WorkoutRequest } from '@/lib/types';
import type { Rng } from '@/lib/rng';

const RECENT_WORKOUTS = 2;

export function historyWeight(id: string, history: HistoryEntry[]): number {
  const recent = history.slice(0, RECENT_WORKOUTS).flatMap((h) => h.exerciseIds);
  return recent.includes(id) ? 0.25 : 1;
}

const score = (rng: Rng, id: string, history: HistoryEntry[]) =>
  historyWeight(id, history) * (0.5 + rng());

export function weightedPick<T extends { id: string }>(
  rng: Rng, items: T[], history: HistoryEntry[],
): T | undefined {
  if (items.length === 0) return undefined;
  let best = items[0];
  let bestScore = -1;
  for (const item of items) {
    const s = score(rng, item.id, history);
    if (s > bestScore) { bestScore = s; best = item; }
  }
  return best;
}

const mechanicRank = (e: Exercise): number => {
  if (e.mechanic === 'ballistic') return 0;
  if (e.mechanic === 'carry' || e.patterns[0] === 'core') return 2;
  return 1;
};

export function orderCircuit(items: Exercise[]): Exercise[] {
  const out = [...items].sort((a, b) => mechanicRank(a) - mechanicRank(b));
  for (let i = 1; i < out.length; i++) {
    if (out[i].patterns[0] !== out[i - 1].patterns[0]) continue;
    const j = out.findIndex((c, k) => k > i && c.patterns[0] !== out[i - 1].patterns[0]);
    if (j > -1) [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

export function selectCircuit(
  pool: Exercise[], req: WorkoutRequest, rng: Rng, history: HistoryEntry[], count: number,
): Exercise[] {
  const chosen: Exercise[] = [];
  const taken = new Set<string>();

  for (const pattern of req.patterns) {
    if (chosen.length >= count) break;
    const candidates = pool.filter((e) => !taken.has(e.id) && e.patterns[0] === pattern);
    const fallback = pool.filter((e) => !taken.has(e.id) && e.patterns.includes(pattern));
    const picked = weightedPick(rng, candidates.length ? candidates : fallback, history);
    if (picked) { chosen.push(picked); taken.add(picked.id); }
  }

  while (chosen.length < count) {
    const picked = weightedPick(rng, pool.filter((e) => !taken.has(e.id)), history);
    if (!picked) break;
    chosen.push(picked); taken.add(picked.id);
  }

  return orderCircuit(chosen);
}

export function selectStrength(
  pool: Exercise[], req: WorkoutRequest, rng: Rng, history: HistoryEntry[],
): Exercise[] {
  const grinds = pool.filter((e) => e.mechanic === 'grind');
  const primary = weightedPick(rng, grinds.length ? grinds : pool, history);
  if (!primary) return [];
  const chosen = [primary];
  const taken = new Set([primary.id]);
  const usedPatterns = new Set([primary.patterns[0]]);

  while (chosen.length < 3) {
    const fresh = pool.filter((e) => !taken.has(e.id) && !usedPatterns.has(e.patterns[0]));
    const any = pool.filter((e) => !taken.has(e.id));
    const picked = weightedPick(rng, fresh.length ? fresh : any, history);
    if (!picked) break;
    chosen.push(picked); taken.add(picked.id); usedPatterns.add(picked.patterns[0]);
  }
  return chosen;
}

export const selectComplex = (
  combos: Combo[], rng: Rng, history: HistoryEntry[],
): Combo | undefined => weightedPick(rng, combos, history);
```

