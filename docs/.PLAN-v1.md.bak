import { describe, it, expect } from 'vitest';
import { buildSteps, type BlockPlan } from '@/lib/flatten';
import type { Exercise } from '@/lib/types';

const ex = (id: string): Exercise => ({
  id, name: id.toUpperCase(), patterns: ['hinge'], level: 'beginner', mechanic: 'grind',
  unilateral: false, bells: 1, loadBand: 'moderate', secondsPerRep: 2, defaultReps: 10,
  needsBench: false, warmupSuitable: false, cooldownSuitable: false, image: null,
  imagePanels: 1, cues: { setup: ['a'], execution: ['b'], mistakes: ['c'] },
});

const plan: BlockPlan = {
  block: 'Main',
  rounds: 2,
  betweenRoundsRest: 60,
  items: [
    { exercise: ex('a'), bellKg: 16, reps: 10, restSeconds: 30, estSeconds: 20 },
    { exercise: ex('b'), bellKg: 16, reps: 10, restSeconds: 30, estSeconds: 20 },
  ],
};

describe('buildSteps', () => {
  const steps = buildSteps([plan]);

  it('runs every item in every round', () => {
    const work = steps.filter((s) => s.kind === 'work');
    expect(work.map((s) => s.kind === 'work' && s.name)).toEqual(['A', 'B', 'A', 'B']);
  });

  it('never ends on a rest', () => {
    expect(steps[steps.length - 1].kind).toBe('work');
  });

  it('uses the between-rounds rest at the end of a round', () => {
    const rests = steps.filter((s) => s.kind === 'rest');
    expect(rests.map((s) => s.kind === 'rest' && s.seconds)).toEqual([30, 60, 30]);
  });

  it('names what comes next on every rest', () => {
    for (const s of steps) if (s.kind === 'rest') expect(s.nextName).toMatch(/^(A|B)$/);
  });

  it('records the position within the round', () => {
    const first = steps[0];
    expect(first.kind === 'work' && first.round).toBe(1);
    expect(first.kind === 'work' && first.totalRounds).toBe(2);
    expect(first.kind === 'work' && first.indexInRound).toBe(1);
    expect(first.kind === 'work' && first.itemsInRound).toBe(2);
  });

  it('carries the last rest of a block into the first item of the next', () => {
    const two = buildSteps([
      { ...plan, block: 'Warm-up', rounds: 1, items: [plan.items[0]] },
      { ...plan, block: 'Main', rounds: 1, items: [{ ...plan.items[1], exercise: ex('z') }] },
    ]);
    const rest = two.find((s) => s.kind === 'rest');
    expect(rest && rest.kind === 'rest' && rest.nextName).toBe('Z');
  });
});
